<!DOCTYPE html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>방명록</title>
    <link rel="stylesheet" href="/guestbook.css" />
  </head>
  <body>
    <div class="container">
      <h1>📝 유삔니의 방명록</h1>
      <form action="/guestbook" method="POST">
          <input type="text" id="author" name="author" placeholder="이름" required />
            <textarea id="message" name="message" placeholder="메세지" required></textarea>
            <button type="submit">등록</button> </form>
      <h2>방명록 목록</h2>
      <div class="entries">
        <% entries.forEach(entry => { %>
        <div class="entry">
          <div class="entry-header">
            <div class="author"><%= entry.author %></div>
            <div class="date"><%= entry.createdAt.toLocaleString() %></div>
          </div>
          <div class="message"><%= entry.message %></div>
        </div>
        <% }) %>
    </form>
    </div>
    </div>
  </body>
  <script src="guestbook.js"></script>
</html>